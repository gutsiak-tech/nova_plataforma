# =============================================================================
# CAGED Dashboard — variáveis de ambiente (copie para .env e ajuste)
# Não commite o arquivo .env nem credenciais reais.
# =============================================================================

# --- Competência e escopo padrão (pipeline e /ready) ---
# Ano e mês usados quando não informados na CLI ou na API.
DEFAULT_ANO=2026
DEFAULT_MES=4
# UF de referência em recortes territoriais (ex.: PR).
DEFAULT_UF=PR

# --- Identificação da API (/health, /ready, logs de startup) ---
# Ambiente lógico: local | staging | production
# Em production: /docs, /redoc e /openapi.json ficam desabilitados.
APP_ENV=local
# Versão exibida nos endpoints de saúde.
APP_VERSION=dev

# --- Segurança ---
# Token Bearer para POST /api/admin/*, /api/debug/* (quando habilitadas)
# e GET /api/ops/fallbacks em APP_ENV=production.
# Gere um valor longo e aleatório (mín. 16 chars); nunca commite o token real.
ADMIN_BEARER_TOKEN=
# Rotas admin (/api/admin/*). Desligado por padrão em APP_ENV=production.
ENABLE_ADMIN_ROUTES=false
# Rotas de debug (/api/debug/*). Desligado por padrão.
ENABLE_DEBUG_ROUTES=false
# Rate limiting por IP (habilitado por padrão em production).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# Origens CORS permitidas (separadas por vírgula). Vazio = defaults de desenvolvimento.
# Exemplo produção:
# CORS_ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com
CORS_ALLOWED_ORIGINS=

# --- Bronze — validação de ingestão (opcional; valores padrão no código) ---
BRONZE_MIN_FILE_SIZE_WARNING_BYTES=50000
BRONZE_SAMPLE_ROWS=100

# Gold backend: filesystem | postgis
# Em produção pública use postgis (com usuário read-only no Postgres).
GOLD_BACKEND=filesystem

# --- PostgreSQL / PostGIS ---
# Não exponha Postgres na internet; use usuário read-only em produção.
# Exemplo de criação: sql/create_readonly_user.example.sql
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=plataforma
POSTGRES_USER=caged_readonly
POSTGRES_PASSWORD=change-me

# =============================================================================
# Exemplo mínimo para publicação em domínio público (ajuste antes do deploy)
# =============================================================================
#
# APP_ENV=production
# APP_VERSION=1.0.0
# GOLD_BACKEND=postgis
# CORS_ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com
# ADMIN_BEARER_TOKEN=change-me-long-random-token
# ENABLE_ADMIN_ROUTES=false
# ENABLE_DEBUG_ROUTES=false
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60
#
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=plataforma
# POSTGRES_USER=caged_readonly
# POSTGRES_PASSWORD=change-me

# --- Logs (informativo) ---
# A API grava em logs/api.log e o pipeline em logs/pipeline.log.
# Caminhos são fixos em app/core/config.py (não há variável de ambiente).
